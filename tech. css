/* GENERAL SETTINGS */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #0b1020;
    color: #ffffff;
    line-height: 1.6;
}

/* HEADER */
header {
    background: #111a33;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

header h1 {
    color: #00e5ff;
    font-size: 28px;
}

nav a {
    color: #ffffff;
    text-decoration: none;
    margin-left: 20px;
    font-size: 16px;
    transition: 0.3s;
}

nav a:hover {
    color: #00e5ff;
}

/* HERO SECTION */
.hero {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 60px 20px;
    background: linear-gradient(135deg, #0b1020, #172554);
}

.hero h2 {
    font-size: clamp(32px, 5vw, 55px);
    margin-bottom: 20px;
}

.hero p {
    max-width: 650px;
    color: #cbd5e1;
    font-size: 18px;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    background: #00e5ff;
    color: #06111f;
    padding: 12px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.btn:hover {
    background: #ffffff;
    transform: translateY(-3px);
}

/* SECTIONS */
section {
    padding: 70px 8%;
}

section h2 {
    font-size: 32px;
    margin-bottom: 20px;
    text-align: center;
}

/* SERVICE CARDS */
.services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 25px;
    margin-top: 35px;
}

.card {
    background: #111a33;
    padding: 30px;
    border-radius: 12px;
    border: 1px solid #243252;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
    border-color: #00e5ff;
}

.card h3 {
    color: #00e5ff;
    margin-bottom: 12px;
}

/* ABOUT SECTION */
.about {
    background: #111a33;
    text-align: center;
}

.about p {
    max-width: 800px;
    margin: auto;
    color: #cbd5e1;
}

/* CONTACT SECTION */
.contact {
    text-align: center;
}

.contact p {
    margin-bottom: 12px;
}

/* FOOTER */
footer {
    background: #070b16;
    text-align: center;
    padding: 25px;
    color: #94a3b8;
}

/* MOBILE RESPONSIVENESS */
@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    nav a {
        margin-left: 0;
    }

    section {
        padding: 50px 6%;
    }
}
